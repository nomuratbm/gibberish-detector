# --- Gibberish Detector API configuration ---
# Copy this file to `.env` and adjust values for your environment.

# HuggingFace model id for the fine-tuned gibberish classifier.
MODEL_ID=madhurjindal/autonlp-Gibberish-Detector-492513457

# Comma-separated labels that should be treated as gibberish.
# Leave EMPTY to use the default rule: any label that is not `clean` is gibberish.
# Example explicit list: noise,word_salad,mild_gibberish
GIBBERISH_LABELS=

# Reject inputs longer than this many characters (keeps tokenization cheap).
MAX_TEXT_LENGTH=512

# Comma-separated origins allowed by CORS (your Amplify domain).
# Example: https://main.d1nln3xyz.amplifyapp.com
ALLOWED_ORIGINS=http://localhost:5173

# Require the X-API-Key header on /api/detect to prevent public abuse.
REQUIRE_API_KEY=true
# The shared secret your front-end must send in the X-API-Key header.
API_KEY=change-me-to-a-long-random-string

# Port the Flask/Waitress server listens on (ngrok forwards to this).
PORT=5000

# --- Heuristic rules that fix known model failure modes ---
# Master switch. Set to false to fall back to raw model output.
ENABLE_HEURISTICS=true

# Rule 1: force GIBBERISH when a longer string has no dictionary word
# (fixes "awawawa..." being read as mild_gibberish).
# A token is a "real word" if it is at least this many characters
# (default 4) AND is in the built-in common-English word set.
MIN_REAL_WORD_LENGTH=4
# Minimum count of alphabetic characters required before Rule 1 can
# fire, so pure numeric / punctuation input is not auto-flagged.
# Set to 0 to disable Rule 1.
FORCE_GIBBERISH_MIN_ALPHA=5

# Rule 2: force CLEAN when the input is short AND contains a real word
# (protects event titles like "Tech Week 2026").
# A string is considered short only if it has <= this many characters
# AND <= this many tokens. Set either to 0 to disable Rule 2.
SHORT_INPUT_MAX_CHARS=20
SHORT_INPUT_MAX_TOKENS=4

# Rule 3: confidence gate. If the model's chosen gibberish label has a
# softmax score below this, downgrade the response to is_gibberish=false.
# Set to 0 to disable.
CONFIDENCE_THRESHOLD=0.85
